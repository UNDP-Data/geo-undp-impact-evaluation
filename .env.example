# =============================================================================
# UNDP Impact Evaluation Pipeline — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# =============================================================================

# --- Google Earth Engine ---
# Authenticate once with: earthengine authenticate
# GEE_PROJECT=your-gee-project-id

# --- ACLED Conflict Data ---
# Register at https://acleddata.com/
ACLED_EMAIL=your-email@example.com
ACLED_KEY=your-acled-api-key

# --- Optional ---
# GOOGLE_TRENDS_PROXY=  # If you need a proxy for pytrends
